# Clé serveur de l'assistant cartographique. Ne jamais utiliser NEXT_PUBLIC_ ici.
OPENAI_API_KEY=
# Optionnel : web (défaut), free (Wikidata/Wikipédia/Banque mondiale), off.
DROMAP_AI_RESEARCH_MODE=web
# Optionnel : journaliser niveau, modèle et raisons du routage, sans données sensibles.
DROMAP_AI_DEBUG=false
